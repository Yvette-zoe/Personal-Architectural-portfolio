---
import { publicImages } from '../lib/publicImages';
import { siteConfig } from '../site';

const navItems = [
	{ href: '/', label: '首页' },
	{ href: '/works/', label: '作品' },
	{ href: '/about/', label: '联系' },
];

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const isHome =
	currentPath === base ||
	currentPath === `${base}index.html` ||
	currentPath.replace(/\/$/, '') === base.replace(/\/$/, '');

function isActive(href: string) {
	if (href === '/') return isHome;
	if (href.startsWith('/works')) return currentPath.includes('/works');
	if (href.startsWith('/about')) return currentPath.includes('/about');
	return false;
}

function navHref(href: string) {
	return href === '/' ? base : `${base}${href.replace(/^\//, '')}`;
}
---

<header class="site-header" data-header>
	<div class="header-bg" aria-hidden="true">
		<img src={publicImages.navBackground} alt="" />
		<div class="header-bg-overlay" />
	</div>
	<div class="header-inner container">
		<a href={base} class="logo">
			<img class="logo-avatar" src={publicImages.avatar} alt="" width="32" height="32" />
			<span class="logo-text">{siteConfig.brand}</span>
		</a>

		<button
			type="button"
			class="nav-toggle"
			aria-label="打开菜单"
			aria-expanded="false"
			aria-controls="site-nav"
		>
			<span class="nav-toggle-bar"></span>
			<span class="nav-toggle-bar"></span>
			<span class="nav-toggle-bar"></span>
		</button>

		<nav id="site-nav" class="site-nav" aria-label="主导航">
			<ul class="nav-list">
				{
					navItems.map((item) => (
						<li>
							<a href={navHref(item.href)} class:list={['nav-link', { active: isActive(item.href) }]}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
	const nav = document.querySelector<HTMLElement>('.site-nav');

	const onScroll = () => {
		if (!header) return;
		header.classList.toggle('is-scrolled', window.scrollY > 50);
	};

	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });

	toggle?.addEventListener('click', () => {
		const expanded = toggle.getAttribute('aria-expanded') === 'true';
		toggle.setAttribute('aria-expanded', String(!expanded));
		nav?.classList.toggle('is-open', !expanded);
		document.body.classList.toggle('nav-open', !expanded);
	});
</script>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		transition: background var(--transition), backdrop-filter var(--transition), border-color var(--transition);
	}

	.header-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.header-bg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.header-bg-overlay {
		position: absolute;
		inset: 0;
		background: rgba(255, 255, 255, 0.7);
	}

	.site-header:not(.is-scrolled) {
		background: transparent;
		border-bottom: 1px solid transparent;
	}

	.site-header.is-scrolled {
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--color-border);
	}

	.header-inner {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: var(--header-height);
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 1.25rem;
		font-weight: 300;
		letter-spacing: var(--tracking-wide);
		color: var(--color-text);
	}

	.logo:hover {
		opacity: 0.8;
	}

	.logo-avatar {
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		border: 1px solid var(--color-border);
		object-fit: cover;
		flex-shrink: 0;
	}

	.logo-text {
		font-family: var(--font-sans);
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: none;
		background: transparent;
		cursor: pointer;
	}

	.nav-toggle-bar {
		display: block;
		width: 1.25rem;
		height: 2px;
		background: var(--color-text);
	}

	.nav-list {
		display: flex;
		gap: 3rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-link {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--color-text-secondary);
		letter-spacing: var(--tracking-chinese);
		transition: color var(--transition);
	}

	.nav-link:hover,
	.nav-link.active {
		color: var(--color-text);
	}

	@media (max-width: 768px) {
		.nav-toggle {
			display: flex;
		}

		.nav-list {
			gap: 0;
		}

		.site-nav {
			position: fixed;
			inset: var(--header-height) 0 0 0;
			background: rgba(255, 255, 255, 0.98);
			padding: var(--space-lg);
			transform: translateX(100%);
			transition: transform var(--transition);
		}

		.site-nav.is-open {
			transform: translateX(0);
		}

		.site-nav .nav-list {
			flex-direction: column;
			gap: var(--space-md);
		}

		.nav-link {
			font-size: 1.125rem;
		}
	}
</style>
