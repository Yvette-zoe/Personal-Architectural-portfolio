---
import type { CollectionEntry } from 'astro:content';
import { getDisplayId, getProjectSlug, projectUrl, resolveProjectAssets } from '../utils/projects';

interface Props {
	project: CollectionEntry<'projects'>;
	index: number;
}

const { project, index } = Astro.props;
const slug = getProjectSlug(project);
const assets = resolveProjectAssets(project);
const { title, subtitle, year, category, description } = project.data;
const displayId = getDisplayId(project, index);
const href = projectUrl(slug);

if (!assets) return null;
---

<article class="works-item">
	<a href={href} class="works-item-link">
		<span class="works-item-id">{displayId}</span>
		<div class="works-item-body">
			<div class="works-item-head">
				<h2 class="works-item-title font-display">{title}</h2>
				<span class="works-item-year">{year}</span>
			</div>
			{subtitle && <p class="works-item-subtitle">{subtitle}</p>}
			<p class="works-item-desc">{description}</p>
			<span class="works-item-category">{category}</span>
		</div>
		<div class="works-item-thumb">
			<img
				src={assets.thumb}
				alt={`${title} 缩略图`}
				width="256"
				height="256"
				loading="lazy"
				decoding="async"
				class="works-item-img"
			/>
		</div>
	</a>
</article>

<style>
	.works-item {
		border-bottom: 1px solid transparent;
	}

	.works-item-link {
		display: flex;
		align-items: flex-start;
		gap: var(--space-md);
		padding: var(--space-lg) 0;
		transition: opacity var(--transition);
	}

	.works-item-link:hover {
		opacity: 1;
	}

	.works-item-link:hover .works-item-title {
		color: var(--color-text-secondary);
	}

	.works-item-link:hover .works-item-img {
		transform: scale(1.05);
	}

	.works-item-id {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		margin-top: 0.35rem;
		width: 1.5rem;
		flex-shrink: 0;
	}

	.works-item-body {
		flex: 1;
		min-width: 0;
	}

	.works-item-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-sm);
		margin-bottom: 0.5rem;
	}

	.works-item-title {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0;
		color: var(--color-text);
		transition: color var(--transition);
	}

	.works-item-year {
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.works-item-subtitle {
		font-size: 0.875rem;
		color: var(--color-text-secondary);
		margin: 0 0 0.5rem;
	}

	.works-item-desc {
		font-size: 0.875rem;
		color: var(--color-text-muted);
		line-height: var(--leading-chinese);
		margin: 0 0 0.75rem;
		max-width: 36rem;
	}

	.works-item-category {
		font-size: 0.75rem;
		color: var(--color-text-faint);
	}

	.works-item-thumb {
		width: 8rem;
		height: 8rem;
		flex-shrink: 0;
		overflow: hidden;
		background: var(--color-surface);
	}

	.works-item-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	@media (max-width: 640px) {
		.works-item-link {
			flex-wrap: wrap;
		}

		.works-item-thumb {
			width: 100%;
			height: auto;
			aspect-ratio: 16 / 10;
		}
	}
</style>
