---
interface GalleryImage {
	src: string;
	alt: string;
}

interface Props {
	images: GalleryImage[];
	title: string;
}

const { images, title } = Astro.props;
const galleryId = `gallery-${Math.random().toString(36).slice(2, 9)}`;
const slides = images.map((img) => ({ ...img, fullSrc: img.src }));
---

<div class="project-gallery" data-gallery={galleryId} data-count={slides.length}>
	<div class="gallery-viewport">
		<div class="gallery-track">
			{
				slides.map((slide, index) => (
					<div class="gallery-slide" data-slide={index}>
						<img
							src={slide.src}
							alt={slide.alt}
							loading={index === 0 ? 'eager' : 'lazy'}
							decoding="async"
							class="gallery-slide-img"
							data-full-src={slide.fullSrc}
						/>
					</div>
				))
			}
		</div>

		{
			slides.length > 1 && (
				<>
					<button type="button" class="gallery-btn gallery-btn--prev" aria-label="上一张">
						<svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
						</svg>
					</button>
					<button type="button" class="gallery-btn gallery-btn--next" aria-label="下一张">
						<svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
						</svg>
					</button>
					<div class="gallery-counter">
						<span data-current>1</span> / {slides.length}
					</div>
				</>
			)
		}
	</div>

	{
		slides.length > 1 && (
			<div class="gallery-dots">
				{slides.map((_, index) => (
					<button type="button" class="gallery-dot" data-dot={index} aria-label={`第 ${index + 1} 张`} />
				))}
			</div>
		)
	}

	<p class="gallery-hint">左右滑动、拖拽或使用键盘方向键切换图片 · 移动端点击图片可全屏查看</p>
</div>

<dialog class="gallery-lightbox" aria-label={`${title} 全屏预览`}>
	<button type="button" class="lightbox-close" aria-label="关闭">&times;</button>
	<span class="lightbox-counter" data-lightbox-counter></span>
	<img class="lightbox-img" src="" alt="" />
</dialog>

<script>
	function initProjectGallery(root: HTMLElement) {
		const count = Number(root.dataset.count) || 1;
		let index = 0;
		const track = root.querySelector<HTMLElement>('.gallery-track');
		const currentEl = root.querySelector<HTMLElement>('[data-current]');
		const dots = root.querySelectorAll<HTMLButtonElement>('.gallery-dot');
		const dialog = document.querySelector<HTMLDialogElement>('.gallery-lightbox');
		const lightboxImg = dialog?.querySelector<HTMLImageElement>('.lightbox-img');
		const lightboxCounter = dialog?.querySelector<HTMLElement>('[data-lightbox-counter]');
		const closeBtn = dialog?.querySelector<HTMLButtonElement>('.lightbox-close');
		const isMobile = () => window.matchMedia('(max-width: 767px)').matches;

		const update = () => {
			if (track) track.style.transform = `translateX(-${index * 100}%)`;
			if (currentEl) currentEl.textContent = String(index + 1);
			dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
		};

		const go = (next: number) => {
			index = (next + count) % count;
			update();
		};

		root.querySelector('.gallery-btn--prev')?.addEventListener('click', () => go(index - 1));
		root.querySelector('.gallery-btn--next')?.addEventListener('click', () => go(index + 1));
		dots.forEach((dot) => {
			dot.addEventListener('click', () => go(Number(dot.dataset.dot)));
		});

		let touchStartX = 0;
		const viewport = root.querySelector('.gallery-viewport');
		viewport?.addEventListener(
			'touchstart',
			(e) => {
				touchStartX = e.touches[0].clientX;
			},
			{ passive: true },
		);
		viewport?.addEventListener('touchend', (e) => {
			const diff = touchStartX - e.changedTouches[0].clientX;
			if (Math.abs(diff) > 50) go(diff > 0 ? index + 1 : index - 1);
		});

		let mouseDownX = 0;
		viewport?.addEventListener('mousedown', (e) => {
			mouseDownX = e.clientX;
		});
		viewport?.addEventListener('mouseup', (e) => {
			const diff = mouseDownX - e.clientX;
			if (Math.abs(diff) > 50) go(diff > 0 ? index + 1 : index - 1);
		});

		viewport?.addEventListener(
			'wheel',
			(e) => {
				e.preventDefault();
				if (e.deltaY > 0 || e.deltaX > 0) go(index + 1);
				else go(index - 1);
			},
			{ passive: false },
		);

		const onKey = (e: KeyboardEvent) => {
			if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') go(index - 1);
			if (e.key === 'ArrowRight' || e.key === 'ArrowDown') go(index + 1);
			if (e.key === 'Escape' && dialog?.open) dialog.close();
		};
		window.addEventListener('keydown', onKey);

		root.querySelectorAll<HTMLImageElement>('.gallery-slide-img').forEach((img) => {
			img.addEventListener('click', () => {
				if (!isMobile() || !dialog || !lightboxImg) return;
				lightboxImg.src = img.dataset.fullSrc || img.src;
				lightboxImg.alt = img.alt;
				if (lightboxCounter) lightboxCounter.textContent = `${index + 1} / ${count}`;
				dialog.showModal();
			});
		});

		closeBtn?.addEventListener('click', () => dialog?.close());
		dialog?.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});

		update();
	}

	document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initProjectGallery);
</script>

<style>
	.project-gallery {
		margin-bottom: var(--space-xl);
	}

	.gallery-viewport {
		position: relative;
		overflow: hidden;
		background: var(--color-surface);
		height: 25vh;
		cursor: grab;
	}

	@media (min-width: 768px) {
		.gallery-viewport {
			height: 70vh;
		}
	}

	.gallery-viewport:active {
		cursor: grabbing;
	}

	.gallery-track {
		display: flex;
		height: 100%;
		transition: transform 0.5s ease-out;
	}

	.gallery-slide {
		flex: 0 0 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-surface);
	}

	.gallery-slide-img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.gallery-btn {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 3rem;
		height: 3rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border: none;
		background: rgba(255, 255, 255, 0.9);
		color: var(--color-text-secondary);
		cursor: pointer;
		opacity: 0.85;
	}

	.gallery-btn--prev {
		left: 1rem;
	}

	.gallery-btn--next {
		right: 1rem;
	}

	.gallery-counter {
		position: absolute;
		bottom: 1rem;
		right: 1rem;
		padding: 0.35rem 0.75rem;
		background: rgba(255, 255, 255, 0.9);
		font-size: 0.75rem;
		color: var(--color-text-secondary);
	}

	.gallery-dots {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.gallery-dot {
		width: 2rem;
		height: 4px;
		padding: 0;
		border: none;
		border-radius: 999px;
		background: var(--color-border);
		cursor: pointer;
	}

	.gallery-dot.is-active {
		background: var(--color-text);
	}

	.gallery-hint {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		text-align: center;
		margin: 1rem 0 0;
	}

	.gallery-lightbox {
		max-width: 100vw;
		width: 100%;
		height: 100%;
		max-height: 100vh;
		padding: 0;
		border: none;
		background: rgba(0, 0, 0, 0.95);
	}

	.lightbox-close {
		position: fixed;
		top: 1rem;
		right: 1rem;
		z-index: 10;
		width: 2.5rem;
		height: 2.5rem;
		border: none;
		background: rgba(255, 255, 255, 0.15);
		color: #fff;
		font-size: 1.5rem;
		cursor: pointer;
		border-radius: 50%;
	}

	.lightbox-counter {
		position: fixed;
		top: 1rem;
		left: 1rem;
		color: rgba(255, 255, 255, 0.8);
		font-size: 0.875rem;
	}

	.lightbox-img {
		display: block;
		max-width: 100%;
		max-height: 100vh;
		margin: auto;
		object-fit: contain;
	}
</style>
