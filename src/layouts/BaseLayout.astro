---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** 首页全屏布局，无默认 main 内边距 */
	fullBleed?: boolean;
}

const {
	title = '建筑作品集',
	description = '个人建筑作品集 — 展示建筑设计与研究项目',
	fullBleed = false,
} = Astro.props;

const fullTitle = title === '建筑作品集' ? `${title} | ZOU YE` : `${title} | ZOU YE`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Noto+Sans+SC:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{fullTitle}</title>
	</head>
	<body>
		<Header />
		<main class:list={[{ 'main--full': fullBleed }]}>
			<slot />
		</main>
		<Footer />
	</body>
</html>
