---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publicImages } from '../lib/publicImages';
import { siteConfig } from '../site';

const backgrounds = publicImages.homeBackgrounds;
const base = import.meta.env.BASE_URL;
---

<BaseLayout fullBleed title="建筑作品集" description="个人建筑作品集 — 展示建筑设计与研究项目">
	<section class="home-hero" data-home-hero>
		<div class="home-bg" aria-hidden="true">
			{
				backgrounds.map((src, i) => (
					<div class="home-bg-layer" data-bg-index={i} class:list={[{ 'is-active': i === 0 }]}>
						<img src={src} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
						<div class="home-bg-overlay" />
					</div>
				))
			}
		</div>

		<div class="home-vertical font-display" aria-hidden="true">Portfolio</div>

		<div class="home-content">
			<p class="home-narrator">{siteConfig.narratorLabel}</p>
			<h1 class="home-title font-display">{siteConfig.name}</h1>
			<p class="home-subtitle">
				{siteConfig.nameEn} | {siteConfig.tagline}
			</p>
			<div class="home-edu">
				{siteConfig.education.map((line) => <p>{line}</p>)}
			</div>
			<a href={`${base}works/`} class="home-cta">查看作品</a>
		</div>

		<div class="home-dots" role="tablist" aria-label="背景切换">
			{
				backgrounds.map((_, i) => (
					<button
						type="button"
						class="home-dot"
						data-dot={i}
						aria-label={`背景 ${i + 1}`}
						aria-selected={i === 0}
						class:list={[{ 'is-active': i === 0 }]}
					/>
				))
			}
		</div>
	</section>
</BaseLayout>

<script is:inline>
	(function () {
		function initHomeHero() {
			var hero = document.querySelector('[data-home-hero]');
			if (!hero) return;

			var layers = hero.querySelectorAll('.home-bg-layer');
			var dots = hero.querySelectorAll('.home-dot');
			var total = layers.length;
			if (total === 0) return;

			var current = 0;
			var INTERVAL_MS = 5000;

			function setBg(index) {
				current = ((index % total) + total) % total;
				for (var i = 0; i < layers.length; i++) {
					layers[i].classList.toggle('is-active', i === current);
				}
				for (var j = 0; j < dots.length; j++) {
					dots[j].classList.toggle('is-active', j === current);
					dots[j].setAttribute('aria-selected', j === current ? 'true' : 'false');
				}
			}

			for (var k = 0; k < dots.length; k++) {
				(function (dot) {
					dot.addEventListener('click', function (e) {
						e.preventDefault();
						e.stopPropagation();
						var idx = parseInt(dot.getAttribute('data-dot'), 10);
						if (!isNaN(idx)) setBg(idx);
					});
				})(dots[k]);
			}

			setBg(0);
			setInterval(function () {
				setBg(current + 1);
			}, INTERVAL_MS);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initHomeHero);
		} else {
			initHomeHero();
		}
	})();
</script>

<style>
	.home-hero {
		position: relative;
		min-height: 100vh;
		overflow: hidden;
	}

	.home-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.home-bg-layer {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 1.5s ease;
	}

	.home-bg-layer.is-active {
		opacity: 1;
	}

	.home-bg-layer img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.home-bg-overlay {
		position: absolute;
		inset: 0;
		background: rgba(255, 255, 255, 0.6);
	}

	.home-vertical {
		position: absolute;
		left: 1rem;
		top: 50%;
		transform: translateY(-50%);
		z-index: 1;
		writing-mode: vertical-rl;
		text-orientation: mixed;
		font-size: clamp(3rem, 10vw, 5rem);
		font-weight: 700;
		letter-spacing: 0.1em;
		color: rgba(139, 74, 74, 0.3);
		user-select: none;
		pointer-events: none;
	}

	@media (min-width: 768px) {
		.home-vertical {
			left: 2rem;
		}
	}

	.home-content {
		position: relative;
		z-index: 2;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 6rem 2rem 5rem;
		text-align: center;
		/* 避免全屏层挡住右下角轮播圆点的点击 */
		pointer-events: none;
	}

	.home-content a {
		pointer-events: auto;
	}

	.home-narrator {
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		color: var(--color-text-secondary);
		margin: 0 0 1rem;
	}

	.home-title {
		font-size: clamp(2.5rem, 8vw, 4.5rem);
		font-weight: 300;
		letter-spacing: var(--tracking-wide);
		margin: 0 0 0.5rem;
		color: var(--color-text);
	}

	.home-subtitle {
		font-size: 1rem;
		color: var(--color-text-secondary);
		margin: 0 0 1.5rem;
	}

	.home-edu {
		font-size: 0.875rem;
		color: var(--color-text-secondary);
		line-height: 1.8;
	}

	.home-edu p {
		margin: 0.15rem 0;
	}

	.home-cta {
		position: absolute;
		bottom: 3rem;
		font-size: 0.75rem;
		color: var(--color-text-secondary);
		border-bottom: 1px solid var(--color-text-secondary);
		padding-bottom: 0.25rem;
		letter-spacing: var(--tracking-chinese);
		transition: color var(--transition), border-color var(--transition);
	}

	.home-cta:hover {
		color: var(--color-text);
		border-color: var(--color-text);
	}

	.home-dots {
		position: absolute;
		bottom: 2rem;
		right: 2rem;
		z-index: 10;
		display: flex;
		gap: 0.5rem;
		pointer-events: auto;
	}

	.home-dot {
		width: 0.5rem;
		height: 0.5rem;
		padding: 0;
		border: none;
		border-radius: 999px;
		background: var(--color-text-muted);
		cursor: pointer;
		pointer-events: auto;
		transition: width var(--transition), background var(--transition);
	}

	.home-dot.is-active {
		width: 1.5rem;
		background: var(--color-text);
	}
</style>
