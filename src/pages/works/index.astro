---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorksListItem from '../../components/WorksListItem.astro';
import { getAllProjects } from '../../utils/projects';

const projects = await getAllProjects();
---

<BaseLayout title="作品" description="建筑作品集 — 全部项目">
	<div class="page-shell page-shell--narrow">
		<div class="works-list">
			{projects.map((project, index) => <WorksListItem project={project} index={index} />)}
		</div>
	</div>
</BaseLayout>

<style>
	.works-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.works-list :global(.works-item) + :global(.works-item) {
		border-top: 1px solid var(--color-border);
	}
</style>
