---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import {
	getAllProjects,
	getAdjacentProjects,
	getDisplayId,
	getProjectSlug,
	resolveProjectAssets,
	projectUrl,
} from '../../utils/projects';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects
		.filter((entry) => resolveProjectAssets(entry))
		.map((entry) => ({
			params: { slug: getProjectSlug(entry) },
			props: { entry },
		}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = getProjectSlug(entry);
const allProjects = await getAllProjects();
const { prev, next, isLast } = getAdjacentProjects(allProjects, slug);
const index = allProjects.findIndex((p) => getProjectSlug(p) === slug);

const {
	title,
	subtitle,
	year,
	description,
	infoCards,
	tags,
	content: structuredContent,
} = entry.data;
const displayId = getDisplayId(entry, index >= 0 ? index : 0);
const assets = resolveProjectAssets(entry)!;
const galleryImages = assets.gallery.map((src, i) => ({
	src,
	alt: `${title} — 图 ${i + 1}`,
}));
const base = import.meta.env.BASE_URL;
const hasStructured = Boolean(
	structuredContent?.background || structuredContent?.concept || structuredContent?.highlights?.length,
);
---

<BaseLayout title={title} description={description}>
	<article class="page-shell page-shell--narrow project-detail">
		<a href={`${base}works/`} class="back-link">
			<span aria-hidden="true">←</span> 返回作品
		</a>

		<header class="detail-header">
			<div class="detail-meta-row">
				<span class="detail-id">{displayId}</span>
				<span class="detail-year">{year}</span>
			</div>
			<h1 class="page-title-display">{title}</h1>
			{subtitle && <p class="detail-subtitle">{subtitle}</p>}
		</header>

		{
			infoCards && infoCards.length > 0 && (
				<dl class="info-grid">
					{infoCards.map((card) => (
						<div>
							<dt>{card.label}</dt>
							<dd>{card.text}</dd>
						</div>
					))}
				</dl>
			)
		}

		{
			tags && tags.length > 0 && (
				<div class="detail-tags">
					{tags.map((tag) => (
						<span class="tag-pill">{tag}</span>
					))}
				</div>
			)
		}

		<ProjectGallery images={galleryImages} title={title} />

		<div class="detail-body">
			{
				hasStructured ? (
					<>
						{structuredContent?.background && (
							<section class="detail-section">
								<h2 class="section-title font-display">项目背景</h2>
								<p class="prose">{structuredContent.background}</p>
							</section>
						)}
						{structuredContent?.concept && (
							<section class="detail-section">
								<h2 class="section-title font-display">设计理念</h2>
								<p class="prose">{structuredContent.concept}</p>
							</section>
						)}
						{structuredContent?.highlights && structuredContent.highlights.length > 0 && (
							<section class="detail-section">
								<h2 class="section-title font-display">设计亮点</h2>
								<ul class="highlight-list">
									{structuredContent.highlights.map((item) => {
										const colon = item.indexOf('：');
										const lead = colon > 0 ? item.slice(0, colon + 1) : '';
										const rest = colon > 0 ? item.slice(colon + 1) : item;
										return (
											<li>
												{lead && <strong>{lead}</strong>}
												{rest}
											</li>
										);
									})}
								</ul>
							</section>
						)}
					</>
				) : (
					<div class="prose">
						<Content />
					</div>
				)
			}
		</div>

		<nav class="project-nav" aria-label="项目导航">
			<div>
				{
					prev && (
						<a href={projectUrl(getProjectSlug(prev))}>
							<span class="project-nav-label">上一个项目</span>
							← {prev.data.title}
						</a>
					)
				}
			</div>
			<div class="project-nav-next">
				{
					next ? (
						<a href={projectUrl(getProjectSlug(next))}>
							<span class="project-nav-label">下一个项目</span>
							{next.data.title} →
						</a>
					) : isLast ? (
						<a href={`${base}works/`}>
							<span class="project-nav-label">返回作品目录</span>
							作品列表 →
						</a>
					) : null
				}
			</div>
		</nav>
	</article>
</BaseLayout>

<style>
	.detail-header {
		margin-bottom: var(--space-xl);
	}

	.detail-meta-row {
		display: flex;
		gap: var(--space-sm);
		margin-bottom: var(--space-md);
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.detail-subtitle {
		font-size: 1.125rem;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.detail-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: var(--space-xl);
	}

	.detail-section {
		margin-bottom: var(--space-xl);
	}

	.detail-section .prose {
		margin: 0;
	}

	.project-nav-next {
		text-align: right;
	}
</style>
